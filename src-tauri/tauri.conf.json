{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offline Preset Editor for Dante",
  "version": "1.0.0",
  "identifier": "uk.co.rjatech.offline-preset-editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Offline Preset Editor for Dante",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Edit Dante Controller presets",
    "longDescription": "Open, edit, route and build Audinate Dante Controller preset files offline.",
    "copyright": "RJATech",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}